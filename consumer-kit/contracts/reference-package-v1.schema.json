{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/precsim/python-numpy-fenics/consumer-kit/contracts/reference-package-v1.schema.json",
  "title": "Downloadable reference bridge package manifest v1",
  "type": "object",
  "required": [
    "format_version",
    "package",
    "version",
    "platform",
    "profile",
    "python_abi",
    "producer",
    "mock",
    "qualification",
    "build",
    "native_closure",
    "runtime",
    "mex",
    "local_host",
    "files"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "package": {
      "$ref": "#/$defs/safeLeafName"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc[0-9]+)?$"
    },
    "platform": {
      "enum": [
        "win-x64",
        "linux-x64",
        "macos-arm64",
        "macos-x64"
      ]
    },
    "profile": {
      "enum": [
        "core",
        "numpy",
        "fenics"
      ]
    },
    "python_abi": {
      "const": "cp314"
    },
    "producer": {
      "type": "object",
      "required": [
        "repository",
        "revision",
        "receipt_path",
        "receipt_sha256",
        "archive_sha256s",
        "manifest_sha256s"
      ],
      "properties": {
        "repository": {
          "const": "precsim/python-numpy-fenics"
        },
        "revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "receipt_path": {
          "const": "evidence/runtime-receipt.json"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive_sha256s": {
          "$ref": "#/$defs/sha256List"
        },
        "manifest_sha256s": {
          "$ref": "#/$defs/sha256List"
        }
      },
      "additionalProperties": false
    },
    "mock": {
      "type": "object",
      "required": [
        "source_revision",
        "backend_path",
        "host_fixture_path"
      ],
      "properties": {
        "source_revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "backend_path": {
          "const": "python/mock_backend.py"
        },
        "host_fixture_path": {
          "const": "host/mock_smoke.m"
        }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": [
        "run_identity",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "run_identity": {
          "type": "string",
          "minLength": 1
        },
        "evidence_path": {
          "const": "evidence/qualification-evidence.json"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": [
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "evidence_path": {
          "const": "evidence/build-evidence.json"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "native_closure": {
      "type": "object",
      "required": [
        "evidence_path",
        "evidence_sha256",
        "summary"
      ],
      "properties": {
        "evidence_path": {
          "const": "evidence/native-closure-evidence.json"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "path",
        "manifest"
      ],
      "properties": {
        "path": {
          "const": "runtime"
        },
        "manifest": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "runtime/runtime-manifest.json"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mex": {
      "type": "object",
      "required": [
        "path",
        "matlab_alias",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "bridge.mex"
        },
        "matlab_alias": {
          "$ref": "#/$defs/safeLeafName"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "local_host": {
      "type": "object",
      "required": [
        "launcher",
        "octave_required",
        "network_required",
        "compiler_required",
        "matlab_qualified"
      ],
      "properties": {
        "launcher": {
          "enum": [
            "run-local-test.ps1",
            "run-local-test.sh"
          ]
        },
        "octave_required": {
          "const": true
        },
        "network_required": {
          "const": false
        },
        "compiler_required": {
          "const": false
        },
        "matlab_qualified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "path",
              "kind",
              "bytes",
              "sha256",
              "mode"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/safeRelativePath"
              },
              "kind": {
                "const": "file"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "mode": {
                "$ref": "#/$defs/mode"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "path",
              "kind",
              "target",
              "mode"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/safeRelativePath"
              },
              "kind": {
                "const": "symlink"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "$ref": "#/$defs/mode"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256List": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "mode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "safeLeafName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)\\.\\.?$).+$"
    }
  },
  "additionalProperties": false
}
