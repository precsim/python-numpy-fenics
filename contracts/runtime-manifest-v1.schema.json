{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/precsim/python-numpy-fenics/contracts/runtime-manifest-v1.schema.json",
  "title": "Python NumPy FEniCS runtime manifest v1",
  "type": "object",
  "required": [
    "format_version",
    "artifact",
    "version",
    "platform",
    "python_abi",
    "profile",
    "producer",
    "files"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platform": {
      "enum": ["win-x64", "linux-x64", "macos-arm64", "macos-x64"]
    },
    "architecture": {
      "type": "string"
    },
    "python_abi": {
      "enum": ["cp312", "cp314"]
    },
    "profile": {
      "enum": ["core", "numpy", "fenics"]
    },
    "tcl_tk": {
      "type": "object",
      "required": ["version", "ownership"],
      "properties": {
        "version": {
          "const": "8.6.18"
        },
        "ownership": {
          "const": "producer"
        },
        "provenance_path": {
          "type": "string",
          "minLength": 1
        },
        "provenance_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "anyOf": [
        {
          "required": ["provenance_path", "provenance_sha256"]
        },
        {
          "required": ["sources", "providers"]
        }
      ],
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "precsim/python-numpy-fenics"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "python_abi": {
            "const": "cp314"
          }
        },
        "required": ["python_abi"]
      },
      "then": {
        "required": ["tcl_tk"]
      }
    }
  ],
  "additionalProperties": true
}
