  "build_policy": {
    "network_disabled_after_input_verification": true,
    "pep517_build_isolation": false,
    "dependency_resolution": false,
    "index_access": false,
    "stage_build_tools_into_runtime": false,
    "host_native_tuning": "forbidden",
    "compiler": "devtoolset-11 GCC/G++ 11.2.1",
    "runtime_symbol_ceilings": {
      "GLIBC": "2.17",
      "CXXABI": "1.3.7",
      "CXXABI_extra_allowed": [
        "CXXABI_TM_1"
      ],
      "GLIBCXX": "3.4.19",
      "GCC": "4.8.0"
    }
  },
  "numpy_build": {
    "backend": "mesonpy",
    "extra_compile_defines": [
      "OPENBLAS_ILP64_NAMING_SCHEME"
    ],
    "openblas_suffix_placement": "fortran-underscore-before-private-symbol-suffix",
    "meson_setup_args": [
      "-Dblas=bridge-openblas",
      "-Dlapack=bridge-openblas",
      "-Dallow-noblas=false",
      "-Duse-ilp64=false",
      "-Dblas-symbol-suffix=bridge_np252_",
      "-Dcpu-baseline=none",
      "-Dcpu-baseline-detect=disabled",
      "-Dcpu-dispatch=X86_V2,X86_V3",
      "-Ddisable-highway=true",
      "-Ddisable-intel-sort=true",
      "-Ddisable-svml=true"
    ],
    "cpu_policy": {
      "baseline": "none",
      "baseline_detect": "disabled",
      "dispatch": [
        "X86_V2",
        "X86_V3"
      ],
      "disabled_components": [
        "highway",
        "intel-x86-sort",
        "svml"
      ]
    }
  },
  "openblas_build": {
    "interface": "LP64",
    "make_options": {
      "BINARY": "64",
      "TARGET": "OPTERON",
      "DYNAMIC_ARCH": "1",
      "DYNAMIC_OLDER": "1",
      "NO_AVX512": "1",
      "NOFORTRAN": "1",
      "USE_THREAD": "1",
      "USE_OPENMP": "0",
      "NO_AFFINITY": "1",
      "NUM_THREADS": "64",
      "CONSISTENT_FPCSR": "1",
      "INTERFACE64": "0",
      "LIBNAMESUFFIX": "bridge_np252_",
      "SYMBOLSUFFIX": "bridge_np252_"
    },
    "runtime_identity": {
      "symbol_suffix": "bridge_np252_",
      "library_name_suffix": "bridge_np252_",
      "collision_policy": "private library identity and private BLAS/LAPACK exported symbols"
    },
    "baseline_probe_environment": {
      "NPY_DISABLE_CPU_FEATURES": "X86_V2,X86_V3",
      "OPENBLAS_CORETYPE": "unset"
    }
  },
  "provider_discovery": {
    "provider": "OpenBLAS 0.3.33",
    "method": "pkg-config-only",
    "pkg_config_name": "bridge-openblas",
    "PKG_CONFIG_LIBDIR": "<openblas-prefix>/lib/pkgconfig",
    "cleared_environment": [
      "PKG_CONFIG_PATH",
      "CMAKE_PREFIX_PATH",
      "BLAS",
      "LAPACK",
      "LD_LIBRARY_PATH",
      "LD_PRELOAD"
    ],
    "cmake_fallback": "forbidden",
    "ambient_blas_lapack": "forbidden"
  },
  "cpu_validation": {
    "numpy_mask_newer_features": true,
    "openblas_runtime_core_selection": "autodetect",
    "reject_openblas_coretype_override": true
  }
}
